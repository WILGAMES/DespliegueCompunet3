{
  "rootDir": "..",
  "testEnvironment": "node",
  "transform": { "^.+\\.(t|j)s$": "@swc/jest" },
  "transformIgnorePatterns": ["node_modules/(?!(?:@nestjs)/)"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "clearMocks": true,
  "testTimeout": 30000
}
