PORT=3000

# --- Base de datos ---
# Supabase: usar el "Session pooler" (Connect > Session pooler), no la conexión directa (solo IPv6).
#   DB_HOST=aws-0-<region>.pooler.supabase.com   POSTGRES_PORT=5432
#   POSTGRES_USER=postgres.<ref-del-proyecto>    POSTGRES_DB=postgres
DB_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# false con un PostgreSQL local o de CI (con Supabase dejar en true)
DB_SSL=true
# Sin definir: true en desarrollo y false si NODE_ENV=production.
# true solo la primera vez (crea las tablas); en el despliegue poner false
# y aplicar los cambios de esquema con scripts/schema-changes.sql
DB_SYNCHRONIZE=true
# Conexiones máximas del pool (Supabase gratis: pocas)
DB_POOL_MAX=10
JWT_SECRET=
GEMINI_API_KEY=

# --- Gemini (validación de publicaciones) ---
GEMINI_MODEL=gemini-3.8-flash
# Tiempo máximo de espera de Gemini en milisegundos
GEMINI_TIMEOUT_MS=10000

# --- Seed: administrador inicial ---
SEED_ADMIN_NAME=Administrador ColSubastas
SEED_ADMIN_EMAIL=admin@colsubastas.com
SEED_ADMIN_PASSWORD=

# --- Subastas ---
# Periodo (ms) del cierre/activación automática de subastas. 0 = desactivado
AUCTION_SWEEP_INTERVAL_MS=5000

# --- Seed de demostración ---
# true (por defecto) carga usuarios, publicaciones, subastas, ofertas y órdenes de ejemplo
# al arrancar, una sola vez. false lo desactiva.
SEED_DEMO_DATA=true
# Contraseña de los usuarios demo (laura.gomez@, carlos.ramirez@, ana.torres@, juan.perez@, sofia.castro@colsubastas.com)
SEED_DEMO_PASSWORD=Demo12345

# Zona horaria: main.ts ya fuerza UTC; definir también TZ=UTC en el servicio de despliegue
TZ=UTC

# --- Órdenes ---
# Horas para pagar una orden desde que se crea. Al vencer pasa a DEFAULTED
# automáticamente. 0 (por defecto) = sin vencimiento.
ORDER_PAYMENT_DEADLINE_HOURS=0
# Periodo (ms) de la revisión de órdenes vencidas (solo si hay plazo)
ORDER_SWEEP_INTERVAL_MS=60000

# --- Seguridad ---
# Orígenes permitidos por CORS (API y Socket.IO), separados por comas, o * para todos.
# Sin definir: cualquiera en desarrollo y ninguno si NODE_ENV=production.
CORS_ORIGINS=
# Detrás de un balanceador/proxy (EC2 + nginx, Render...): número de proxies de
# confianza (1) para que el límite de peticiones use la IP real del cliente.
TRUST_PROXY=
# Límite global de peticiones por IP y ventana (ms)
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000
# Límite de /auth/login y /auth/register por IP y minuto (fuerza bruta)
AUTH_THROTTLE_LIMIT=30
# Swagger en /docs. SWAGGER_ENABLED=false lo apaga; con usuario y contraseña
# exige autenticación básica.
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=
